# Production .env template for the hospital LAN deployment.
#
# 1. Copy this to .env on the deployed server.
# 2. Generate every "GENERATE_ME_*" value fresh — never reuse the dev secrets.
# 3. Update ALLOWED_ORIGINS to the actual hostname / IP techs will use.
#
# Quick value generation on the server:
#
#   POSTGRES_PASSWORD=$(openssl rand -base64 32 | tr -d '=+/')
#   SECRET_KEY=$(openssl rand -base64 64 | tr -d '=+/')
#   echo "POSTGRES_PASSWORD=$POSTGRES_PASSWORD"
#   echo "SECRET_KEY=$SECRET_KEY"

# --- Database ---
POSTGRES_DB=relai
POSTGRES_USER=relai_user
POSTGRES_PASSWORD=GENERATE_ME_strong_password

# --- App ---
# DATABASE_URL must encode the same password as POSTGRES_PASSWORD above.
DATABASE_URL=postgresql+asyncpg://relai_user:GENERATE_ME_strong_password@db:5432/relai
SECRET_KEY=GENERATE_ME_64_char_random_hex_or_base64
ALGORITHM=HS256

# Longer tokens for the in-hospital workflow (techs stay logged in longer).
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS ---
# HTTPS is required: the site firewall blocks plain HTTP to the app VM,
# so nginx terminates TLS on 443 (see nginx/nginx.prod.conf).
# The scheme here MUST match what the browser uses (https://). A mismatch
# (e.g. http:// here while the browser loads https://) breaks the CORS
# origin check and every /api/ call fails.
# Set to the server's actual static IP (or hostname on internal DNS).
# Comma-separated for multiple. Examples:
#   ALLOWED_ORIGINS=https://192.0.2.20
#   ALLOWED_ORIGINS=https://192.0.2.20,https://relai.example.local
ALLOWED_ORIGINS=https://192.0.2.20

# --- Environment ---
# Must be 'production' — disables /docs, /openapi.json, dev create_all, and
# verbose SQL logging.
ENVIRONMENT=production
